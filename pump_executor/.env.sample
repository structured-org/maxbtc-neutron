# -----------------
# Core Application Config
# -----------------
# The period in seconds at which the application will query the Skip API and execute the transaction.
EXECUTE_PERIOD=3
# The address of the CosmWasm contract on the Neutron chain to interact with.
CONTRACT_ADDRESS="neutron1w798gp0zqv3s9hjl3jlnwxtwhykga6rn93p46q2crsdqhaj3y4gsum0096"
# The RPC endpoint for the Neutron chain.
GRPC_ADDRESS="https://rpc.neutron.quokkastake.io"
GRPC_PORT="9090"
# The mnemonic for the wallet that will be used to execute transactions.
# IMPORTANT: Use a dedicated, non-primary wallet for this.
MNEMONIC="stamp walnut alarm response kidney possible crack mass rent screen summer drastic junior spatial forest analyst prize insane okay unfair screen liar match blanket"
# The denom of the token to be transferred.
NEUTRON_DENOM="ibc/0E293A7622DC9A6439DB60E6D234B5AF446962E27CA3AB44D0590603DFF6968E"
HUB_DENOM="ibc/D742E8566B0B8CC8F569D950051C09CF57988A88F0E45574BFB3079D41DE6462"
# A multiplier for the estimated route duration to calculate the final timeout.
EUREKA_FULL_TIMEOUT_MULTIPLIER=10
# Log level (e.g., info, debug, error)
RUST_LOG="debug"

# -----------------
# Skip API Configuration
# -----------------
# The base URL for the Skip API fungible route endpoint
SKIP_API_URL="https://go.skip.build/api/skip/v2/fungible/route"
# The chain ID of the source asset (e.g., "neutron-1")
SOURCE_ASSET_CHAIN_ID="neutron-1"
# The denomination of the destination asset (e.g., WBTC address on Ethereum)
DEST_ASSET_DENOM="0x2260FAC5E5542a773Aa44fBCfeDf7C193bc2C599"
# The chain ID of the destination asset (e.g., "1" for Ethereum Mainnet)
DEST_ASSET_CHAIN_ID="1"

# Allow routes that may require multiple transactions
SKIP_ALLOW_MULTI_TX=true
# Allow routes that may be less safe (e.g., involve contracts with lower liquidity)
SKIP_ALLOW_UNSAFE=true
# Prioritize faster routes, potentially at a higher cost
SKIP_GO_FAST=true
# Use Skip's smart relay feature
SKIP_SMART_RELAY=true
# Allow the router to split the amount across multiple routes to find a better price
SKIP_SPLIT_ROUTES=true
# Allow swaps on EVM chains as part of the route
SKIP_EVM_SWAPS=true

# A comma-separated list of experimental features to enable. Leave empty if none.
# e.g., "eureka,another-feature"
SKIP_EXPERIMENTAL_FEATURES="eureka"