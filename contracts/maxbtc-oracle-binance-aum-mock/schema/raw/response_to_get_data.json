{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GetDataResponse",
  "type": "object",
  "properties": {
    "last_published_data": {
      "description": "The latest published data (can be null if there was no consensus reached)",
      "anyOf": [
        {
          "$ref": "#/definitions/ConsensusOutcome_for_BinanceData"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "definitions": {
    "BinanceData": {
      "type": "object",
      "required": [
        "spot_balances"
      ],
      "properties": {
        "spot_balances": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SpotBalance"
          }
        }
      },
      "additionalProperties": false
    },
    "ConsensusOutcome_for_BinanceData": {
      "type": "object",
      "required": [
        "data"
      ],
      "properties": {
        "data": {
          "description": "The data submitted by the messengers",
          "allOf": [
            {
              "$ref": "#/definitions/BinanceData"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "SignedDecimal256": {
      "description": "A signed fixed-point decimal value with 18 fractional digits, i.e. SignedDecimal256(1_000_000_000_000_000_000) == 1.0\n\nThe greatest possible value that can be represented is 57896044618658097711785492504343953926634992332820282019728.792003956564819967 (which is (2^255 - 1) / 10^18) and the smallest is -57896044618658097711785492504343953926634992332820282019728.792003956564819968 (which is -2^255 / 10^18).",
      "type": "string"
    },
    "SpotBalance": {
      "type": "object",
      "required": [
        "amount",
        "asset"
      ],
      "properties": {
        "amount": {
          "$ref": "#/definitions/SignedDecimal256"
        },
        "asset": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
