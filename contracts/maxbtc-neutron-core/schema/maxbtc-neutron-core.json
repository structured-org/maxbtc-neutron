{
  "contract_name": "maxbtc-neutron-core",
  "contract_version": "0.1.0",
  "idl_version": "1.0.0",
  "instantiate": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "InstantiateMsg",
    "description": "InstantiateMsg configures the contract on initialization.",
    "type": "object",
    "required": [
      "accepted_withdrawable_percentage",
      "aum_contract",
      "batch_active_duration",
      "batch_withdrawing_duration",
      "cached_aum_tolerance",
      "cached_er_ttl",
      "collector_contract",
      "deposit_cost",
      "deposit_decimals",
      "deposit_denom",
      "deposit_flush_period",
      "deposit_pump_contract",
      "fee_collector_params",
      "kyc_checker_contract",
      "liquidation_buffer_contract",
      "liquidation_buffer_share",
      "maxbtc_denom",
      "owner",
      "treasury_address"
    ],
    "properties": {
      "accepted_withdrawable_percentage": {
        "description": "Minimum percentage (Decimal) of `btc_requested` that must be collected for a batch to finalize successfully",
        "allOf": [
          {
            "$ref": "#/definitions/Decimal"
          }
        ]
      },
      "aum_contract": {
        "type": "string"
      },
      "batch_active_duration": {
        "description": "Number of seconds an ACTIVE batch remains open before it can be promoted to WITHDRAWING",
        "type": "integer",
        "format": "uint64",
        "minimum": 0.0
      },
      "batch_withdrawing_duration": {
        "description": "Number of seconds a WITHDRAWING batch may remain open before it must be finalized",
        "type": "integer",
        "format": "uint64",
        "minimum": 0.0
      },
      "cached_aum_tolerance": {
        "description": "Maximum tolerated relative difference (Decimal) between the deposit buffer sent for flushing and the amount observed on the custody chain",
        "allOf": [
          {
            "$ref": "#/definitions/Decimal"
          }
        ]
      },
      "cached_er_ttl": {
        "description": "Lifetime, in seconds, of the cached ER/AUM snapshot that protects the protocol while a multi-step operation is in flight",
        "type": "integer",
        "format": "uint64",
        "minimum": 0.0
      },
      "collector_contract": {
        "description": "Collector contract that receives BTC shipped back from custody during the withdrawal process.",
        "type": "string"
      },
      "deposit_cost": {
        "description": "One-off cost (Decimal) charged when a user deposits to mint maxBTC",
        "allOf": [
          {
            "$ref": "#/definitions/Decimal"
          }
        ]
      },
      "deposit_decimals": {
        "description": "Number of decimals carried by the `deposit_denom` asset",
        "type": "integer",
        "format": "uint32",
        "minimum": 0.0
      },
      "deposit_denom": {
        "description": "Denom for user deposits (e.g. IBC-transferred BTC)",
        "type": "string"
      },
      "deposit_flush_period": {
        "description": "Minimum number of seconds that must elapse between two deposit-flush operations",
        "type": "integer",
        "format": "uint64",
        "minimum": 0.0
      },
      "deposit_pump_contract": {
        "description": "Contract that forwards freshly-received deposits to the custody chain.",
        "type": "string"
      },
      "deposits_allowlist": {
        "description": "Optional allow-list of addresses that may mint maxBTC while the list is active (empty or `None` means open to everyone)",
        "type": [
          "array",
          "null"
        ],
        "items": {
          "type": "string"
        }
      },
      "deposits_cap": {
        "description": "Upper limit on total AUM; deposits are rejected once the cap (if present) is exceeded",
        "anyOf": [
          {
            "$ref": "#/definitions/Uint128"
          },
          {
            "type": "null"
          }
        ]
      },
      "fee_collector_params": {
        "description": "Instantiation parameters for the fee collector.",
        "allOf": [
          {
            "$ref": "#/definitions/FeeMinterParams"
          }
        ]
      },
      "kyc_checker_contract": {
        "description": "The address of the KYC checker contract and is used to check if a user has passed the KYC check",
        "type": "string"
      },
      "liquidation_buffer_contract": {
        "description": "Address of the contract that manages the liquidation buffer.",
        "type": "string"
      },
      "liquidation_buffer_share": {
        "description": "Fraction of total AUM (Decimal) that the protocol keeps on the liquidation buffer contract as an instant-liquidity buffer",
        "allOf": [
          {
            "$ref": "#/definitions/Decimal"
          }
        ]
      },
      "maxbtc_denom": {
        "description": "The token-factory sub-denom used for the maxBTC token",
        "type": "string"
      },
      "owner": {
        "type": "string"
      },
      "treasury_address": {
        "description": "Treasury account that receives protocol fees and surplus funds.",
        "type": "string"
      }
    },
    "additionalProperties": false,
    "definitions": {
      "Binary": {
        "description": "Binary is a wrapper around Vec<u8> to add base64 de/serialization with serde. It also adds some helper methods to help encode inline.\n\nThis is only needed as serde-json-{core,wasm} has a horrible encoding for Vec<u8>. See also <https://github.com/CosmWasm/cosmwasm/blob/main/docs/MESSAGE_TYPES.md>.",
        "type": "string"
      },
      "Decimal": {
        "description": "A fixed-point decimal value with 18 fractional digits, i.e. Decimal(1_000_000_000_000_000_000) == 1.0\n\nThe greatest possible value that can be represented is 340282366920938463463.374607431768211455 (which is (2^128 - 1) / 10^18)",
        "type": "string"
      },
      "FeeMinterParams": {
        "description": "New struct to hold parameters for instantiating the fee collector contract.",
        "type": "object",
        "required": [
          "code_id",
          "collection_period_seconds",
          "fee_apy_reduction_percentage",
          "salt"
        ],
        "properties": {
          "code_id": {
            "description": "The code ID of the fee collector contract wasm.",
            "type": "integer",
            "format": "uint64",
            "minimum": 0.0
          },
          "collection_period_seconds": {
            "description": "The duration in hours for each fee collection period.",
            "type": "integer",
            "format": "uint64",
            "minimum": 0.0
          },
          "fee_apy_reduction_percentage": {
            "description": "The percentage of APY to be taken as a fee.",
            "allOf": [
              {
                "$ref": "#/definitions/Decimal"
              }
            ]
          },
          "salt": {
            "description": "A unique salt for generating a predictable address with Instantiate2.",
            "allOf": [
              {
                "$ref": "#/definitions/Binary"
              }
            ]
          }
        },
        "additionalProperties": false
      },
      "Uint128": {
        "description": "A thin wrapper around u128 that is using strings for JSON encoding/decoding, such that the full u128 range can be used for clients that convert JSON numbers to floats, like JavaScript and jq.\n\n# Examples\n\nUse `from` to create instances of this and `u128` to get the value out:\n\n``` # use cosmwasm_std::Uint128; let a = Uint128::from(123u128); assert_eq!(a.u128(), 123);\n\nlet b = Uint128::from(42u64); assert_eq!(b.u128(), 42);\n\nlet c = Uint128::from(70u32); assert_eq!(c.u128(), 70); ```",
        "type": "string"
      }
    }
  },
  "execute": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "ExecuteMsg",
    "description": "ExecuteMsg enumerates all possible actions in this contract.",
    "oneOf": [
      {
        "description": "User deposit flow",
        "type": "object",
        "required": [
          "deposit"
        ],
        "properties": {
          "deposit": {
            "type": "object",
            "required": [
              "recipient"
            ],
            "properties": {
              "recipient": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      {
        "description": "Permissionless handler to flush deposits after `deposit_flush_period`",
        "type": "object",
        "required": [
          "flush_deposits"
        ],
        "properties": {
          "flush_deposits": {
            "type": "object",
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      {
        "description": "User requests a withdrawal of a certain amount of maxBTC",
        "type": "object",
        "required": [
          "withdraw"
        ],
        "properties": {
          "withdraw": {
            "type": "object",
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      {
        "description": "Permissionless handler to process the ACTIVE batch after `batch_active_duration`",
        "type": "object",
        "required": [
          "process_active_batch"
        ],
        "properties": {
          "process_active_batch": {
            "type": "object",
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      {
        "description": "User claims their BTC from a finalized batch",
        "type": "object",
        "required": [
          "claim"
        ],
        "properties": {
          "claim": {
            "type": "object",
            "required": [
              "recipient"
            ],
            "properties": {
              "recipient": {
                "description": "The user wants to receive BTC at `recipient` address on Neutron (which the user can IBC-transfer out later).",
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      {
        "description": "Triggers the execution of _process_cache",
        "type": "object",
        "required": [
          "process_cache"
        ],
        "properties": {
          "process_cache": {
            "type": "object",
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      {
        "description": "Owner-only message to update protocol configuration in-place",
        "type": "object",
        "required": [
          "update_config"
        ],
        "properties": {
          "update_config": {
            "$ref": "#/definitions/UpdateConfigMsg"
          }
        },
        "additionalProperties": false
      },
      {
        "description": "Mints the requested amount of fees to the fee collector address. Can only be executed by the fee collector.",
        "type": "object",
        "required": [
          "mint_fee"
        ],
        "properties": {
          "mint_fee": {
            "type": "object",
            "required": [
              "amount"
            ],
            "properties": {
              "amount": {
                "$ref": "#/definitions/Coin"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    ],
    "definitions": {
      "Coin": {
        "type": "object",
        "required": [
          "amount",
          "denom"
        ],
        "properties": {
          "amount": {
            "$ref": "#/definitions/Uint128"
          },
          "denom": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "Decimal": {
        "description": "A fixed-point decimal value with 18 fractional digits, i.e. Decimal(1_000_000_000_000_000_000) == 1.0\n\nThe greatest possible value that can be represented is 340282366920938463463.374607431768211455 (which is (2^128 - 1) / 10^18)",
        "type": "string"
      },
      "Uint128": {
        "description": "A thin wrapper around u128 that is using strings for JSON encoding/decoding, such that the full u128 range can be used for clients that convert JSON numbers to floats, like JavaScript and jq.\n\n# Examples\n\nUse `from` to create instances of this and `u128` to get the value out:\n\n``` # use cosmwasm_std::Uint128; let a = Uint128::from(123u128); assert_eq!(a.u128(), 123);\n\nlet b = Uint128::from(42u64); assert_eq!(b.u128(), 42);\n\nlet c = Uint128::from(70u32); assert_eq!(c.u128(), 70); ```",
        "type": "string"
      },
      "UpdateConfigMsg": {
        "description": "Message for updating configuration parameters (owner-only).",
        "type": "object",
        "properties": {
          "accepted_withdrawable_percentage": {
            "anyOf": [
              {
                "$ref": "#/definitions/Decimal"
              },
              {
                "type": "null"
              }
            ]
          },
          "aum_contract": {
            "type": [
              "string",
              "null"
            ]
          },
          "batch_active_duration": {
            "type": [
              "integer",
              "null"
            ],
            "format": "uint64",
            "minimum": 0.0
          },
          "batch_withdrawing_duration": {
            "type": [
              "integer",
              "null"
            ],
            "format": "uint64",
            "minimum": 0.0
          },
          "cached_aum_tolerance": {
            "anyOf": [
              {
                "$ref": "#/definitions/Decimal"
              },
              {
                "type": "null"
              }
            ]
          },
          "cached_er_ttl": {
            "type": [
              "integer",
              "null"
            ],
            "format": "uint64",
            "minimum": 0.0
          },
          "collector_contract": {
            "type": [
              "string",
              "null"
            ]
          },
          "deposit_cost": {
            "anyOf": [
              {
                "$ref": "#/definitions/Decimal"
              },
              {
                "type": "null"
              }
            ]
          },
          "deposit_flush_period": {
            "type": [
              "integer",
              "null"
            ],
            "format": "uint64",
            "minimum": 0.0
          },
          "deposit_pump_contract": {
            "type": [
              "string",
              "null"
            ]
          },
          "deposits_cap": {
            "anyOf": [
              {
                "anyOf": [
                  {
                    "$ref": "#/definitions/Uint128"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "fee_collector_contract": {
            "type": [
              "string",
              "null"
            ]
          },
          "kyc_checker_contract": {
            "type": [
              "string",
              "null"
            ]
          },
          "liquidation_buffer_share": {
            "anyOf": [
              {
                "$ref": "#/definitions/Decimal"
              },
              {
                "type": "null"
              }
            ]
          },
          "liquidation_contract": {
            "type": [
              "string",
              "null"
            ]
          },
          "owner": {
            "type": [
              "string",
              "null"
            ]
          },
          "paused": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "treasury_address": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "query": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "QueryMsg",
    "description": "QueryMsg for reading contract states.",
    "oneOf": [
      {
        "description": "Returns the Config state",
        "type": "object",
        "required": [
          "config"
        ],
        "properties": {
          "config": {
            "type": "object",
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      {
        "description": "Returns info about the current ACTIVE batch",
        "type": "object",
        "required": [
          "active_batch"
        ],
        "properties": {
          "active_batch": {
            "type": "object",
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      {
        "description": "Returns info about the current WITHDRAWING batch",
        "type": "object",
        "required": [
          "withdrawing_batch"
        ],
        "properties": {
          "withdrawing_batch": {
            "type": "object",
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      {
        "description": "Returns info for a finalized batch by id",
        "type": "object",
        "required": [
          "finalized_batch"
        ],
        "properties": {
          "finalized_batch": {
            "type": "object",
            "required": [
              "batch_id"
            ],
            "properties": {
              "batch_id": {
                "type": "integer",
                "format": "uint64",
                "minimum": 0.0
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      {
        "description": "Returns the current FSM state",
        "type": "object",
        "required": [
          "contract_state"
        ],
        "properties": {
          "contract_state": {
            "type": "object",
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      {
        "type": "object",
        "required": [
          "exchange_rate"
        ],
        "properties": {
          "exchange_rate": {
            "type": "object",
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    ]
  },
