{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Nullable_BatchResponse",
  "anyOf": [
    {
      "$ref": "#/definitions/BatchResponse"
    },
    {
      "type": "null"
    }
  ],
  "definitions": {
    "BatchResponse": {
      "description": "Response for batch query",
      "type": "object",
      "required": [
        "batch_id",
        "btc_requested",
        "collected_amount",
        "collector_historical_balance",
        "maxbtc_burned"
      ],
      "properties": {
        "batch_id": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "btc_requested": {
          "type": "string"
        },
        "collected_amount": {
          "type": "string"
        },
        "collector_historical_balance": {
          "type": "string"
        },
        "maxbtc_burned": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
