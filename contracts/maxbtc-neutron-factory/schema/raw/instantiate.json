{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "InstantiateMsg",
  "description": "InstantiateMsg configures the contract on initialization.",
  "type": "object",
  "required": [
    "code_ids",
    "deposit_cost",
    "deposit_decimals",
    "deposit_denom",
    "deposit_flush_period",
    "fee_collector_params",
    "maxbtc_denom",
    "operator",
    "owner",
    "salt",
    "valence_ibc_transfer_params"
  ],
  "properties": {
    "code_ids": {
      "$ref": "#/definitions/CodeIds"
    },
    "deposit_cost": {
      "description": "One-off cost (Decimal) charged when a user deposits to mint maxBTC",
      "allOf": [
        {
          "$ref": "#/definitions/Decimal"
        }
      ]
    },
    "deposit_decimals": {
      "description": "Number of decimals carried by the `deposit_denom` asset",
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    },
    "deposit_denom": {
      "description": "Denom for user deposits (e.g. IBC-transferred BTC)",
      "type": "string"
    },
    "deposit_flush_period": {
      "description": "Minimum number of seconds that must elapse between two deposit-flush operations",
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    },
    "deposits_cap": {
      "description": "Upper limit on total AUM; deposits are rejected once the cap (if present) is exceeded",
      "anyOf": [
        {
          "$ref": "#/definitions/Uint128"
        },
        {
          "type": "null"
        }
      ]
    },
    "fee_collector_params": {
      "description": "Instantiation parameters for the fee collector.",
      "allOf": [
        {
          "$ref": "#/definitions/FeeMinterParams"
        }
      ]
    },
    "maxbtc_denom": {
      "description": "Token factory sub-denom",
      "type": "string"
    },
    "operator": {
      "type": "string"
    },
    "owner": {
      "type": "string"
    },
    "salt": {
      "type": "string"
    },
    "valence_ibc_transfer_params": {
      "description": "Valence IBC transfer",
      "allOf": [
        {
          "$ref": "#/definitions/ValenceIbcTransferLibraryConfigParams"
        }
      ]
    }
  },
  "additionalProperties": false,
  "definitions": {
    "CodeIds": {
      "type": "object",
      "required": [
        "allowlist_contract_code_id",
        "core_code_id",
        "deposit_forwarder_contract_code_id",
        "deposit_forwarder_library_contract_code_id",
        "exchange_rate_provider_contract_code_id",
        "fee_collector_contract_code_id",
        "token_code_id"
      ],
      "properties": {
        "allowlist_contract_code_id": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "core_code_id": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "deposit_forwarder_contract_code_id": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "deposit_forwarder_library_contract_code_id": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "exchange_rate_provider_contract_code_id": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "fee_collector_contract_code_id": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "token_code_id": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    },
    "Decimal": {
      "description": "A fixed-point decimal value with 18 fractional digits, i.e. Decimal(1_000_000_000_000_000_000) == 1.0\n\nThe greatest possible value that can be represented is 340282366920938463463.374607431768211455 (which is (2^128 - 1) / 10^18)",
      "type": "string"
    },
    "Denom": {
      "type": "object",
      "required": [
        "native"
      ],
      "properties": {
        "native": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "EurekaConfig": {
      "type": "object",
      "required": [
        "action_contract",
        "callback_contract",
        "recover_address",
        "source_channel"
      ],
      "properties": {
        "action_contract": {
          "type": "string"
        },
        "callback_contract": {
          "type": "string"
        },
        "recover_address": {
          "type": "string"
        },
        "source_channel": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "FeeMinterParams": {
      "description": "New struct to hold parameters for instantiating the fee collector contract.",
      "type": "object",
      "required": [
        "collection_period_seconds",
        "fee_apy_reduction_percentage"
      ],
      "properties": {
        "collection_period_seconds": {
          "description": "The duration in hours for each fee collection period.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "fee_apy_reduction_percentage": {
          "description": "The percentage of APY to be taken as a fee.",
          "allOf": [
            {
              "$ref": "#/definitions/Decimal"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "InputAddr": {
      "type": "object",
      "required": [
        "library_account_addr"
      ],
      "properties": {
        "library_account_addr": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "OutputAddr": {
      "type": "object",
      "required": [
        "library_account_addr"
      ],
      "properties": {
        "library_account_addr": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "RemoteChainInfo": {
      "type": "object",
      "required": [
        "channel_id"
      ],
      "properties": {
        "channel_id": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "Uint128": {
      "description": "A thin wrapper around u128 that is using strings for JSON encoding/decoding, such that the full u128 range can be used for clients that convert JSON numbers to floats, like JavaScript and jq.\n\n# Examples\n\nUse `from` to create instances of this and `u128` to get the value out:\n\n``` # use cosmwasm_std::Uint128; let a = Uint128::from(123u128); assert_eq!(a.u128(), 123);\n\nlet b = Uint128::from(42u64); assert_eq!(b.u128(), 42);\n\nlet c = Uint128::from(70u32); assert_eq!(c.u128(), 70); ```",
      "type": "string"
    },
    "ValenceIbcTransferLibraryConfigParams": {
      "type": "object",
      "required": [
        "amount",
        "denom",
        "denom_to_pfm_map",
        "eureka_config",
        "input_addr",
        "memo",
        "output_addr",
        "remote_chain_info"
      ],
      "properties": {
        "amount": {
          "type": "string"
        },
        "denom": {
          "$ref": "#/definitions/Denom"
        },
        "denom_to_pfm_map": {
          "type": "object",
          "additionalProperties": false
        },
        "eureka_config": {
          "$ref": "#/definitions/EurekaConfig"
        },
        "input_addr": {
          "$ref": "#/definitions/InputAddr"
        },
        "memo": {
          "type": "string"
        },
        "output_addr": {
          "$ref": "#/definitions/OutputAddr"
        },
        "remote_chain_info": {
          "$ref": "#/definitions/RemoteChainInfo"
        }
      },
      "additionalProperties": false
    }
  }
}
